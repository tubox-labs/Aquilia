# ──────────────────────────────────────────────────────────────────
# rest_api_contract -- Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
AQ_ENV=dev                               # dev | prod | test
AQ_HOST=127.0.0.1
AQ_PORT=8000
AQ_WORKERS=1                             # Set to CPU count in prod
AQ_DEBUG=true                             # false in prod

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost:5432/rest_api_contract
# DATABASE_URL=mysql://user:password@localhost:3306/rest_api_contract

# ── Security ──────────────────────────────────────────────────────
AQ_SECRET_KEY=change-me-in-production
# JWT_SECRET_KEY=
# ALLOWED_HOSTS=localhost,127.0.0.1

# ── Cache ─────────────────────────────────────────────────────────
CACHE_BACKEND=memory                   # memory | redis
# REDIS_URL=redis://localhost:6379/0

# ── Mail ──────────────────────────────────────────────────────────
# MAIL_PROVIDER=console                # console | smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.com

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
