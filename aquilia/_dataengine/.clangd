# clangd has no compile_commands.json until CMake generates one, so it falls
# back to C++98 defaults and flags every C++17/20 construct in the headers.
# Python.h and the nanobind headers live outside the source tree, so they stay
# unresolved here too until CMake has been run; that is editor noise, not a
# build problem. The real standard is set in CMakeLists.txt (CMAKE_CXX_STANDARD 20).
CompileFlags:
  Add: [-std=c++20, -Isrc]
